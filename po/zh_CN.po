#: gnome-extension/prefs.js:88
#, no-javascript-format
msgid "Website"
msgstr "网站"

#: gnome-extension/prefs.js:89
#, no-javascript-format
msgid "On GitHub; paste the report below in it"
msgstr "在 GitHub 上提交，并把下面的报告粘贴进去"

#: gnome-extension/prefs.js:89
#, no-javascript-format
